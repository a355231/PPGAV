<Application x:Class="PPGAV.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#0B1018" />
        <SolidColorBrush x:Key="PanelBackground" Color="#121A26" />
        <SolidColorBrush x:Key="PanelBorder" Color="#263449" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EEF4FF" />
        <SolidColorBrush x:Key="TextMuted" Color="#8D9BB2" />
        <SolidColorBrush x:Key="SafeBrush" Color="#35D39A" />
        <SolidColorBrush x:Key="SuspiciousBrush" Color="#F5B94C" />
        <SolidColorBrush x:Key="MalwareBrush" Color="#FF647C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6C8CFF" />
    </Application.Resources>
</Application>
