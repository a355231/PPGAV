<Window x:Class="PPGAV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PPGAV · People Playground Antivirus Guard"
        Width="1200" Height="820" MinWidth="980" MinHeight="680"
        Background="{StaticResource PageBackground}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#1B2638" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#87A0FF" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#432333" />
            <Setter Property="BorderBrush" Value="#834356" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#0E1622" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,5,16,5" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="#0E1622" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="PPGAV" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="People Playground Antivirus Guard" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#102A27" BorderBrush="#245D52" BorderThickness="1" CornerRadius="18" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource SafeBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Checking protection" Foreground="{StaticResource SuspiciousBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="SAFE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" />
                    <TextBlock x:Name="SafeCountText" Text="0" FontSize="31" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="clean files and scans" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="SUSPICIOUS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuspiciousBrush}" />
                    <TextBlock x:Name="SuspiciousCountText" Text="0" FontSize="31" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="needs review" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="MALWARE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MalwareBrush}" />
                    <TextBlock x:Name="MalwareCountText" Text="0" FontSize="31" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="blocked or quarantined" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Launch controls" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="Every launch is scanned first. Secure Sandbox is isolated from the host; Malware Safe Mode strips mods and blocks outbound traffic." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,16" />
                            <WrapPanel>
                                <Button x:Name="SecureLaunchButton" Content="Launch in Secure Sandbox" Style="{StaticResource AccentButton}" Click="SecureLaunch_Click" />
                                <Button Content="Malware Safe Mode" Click="SafeLaunch_Click" />
                                <Button Content="Stop game" Style="{StaticResource DangerButton}" Click="Stop_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="LatestScanText" Text="No scan has run this session." Foreground="{StaticResource TextMuted}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Protection settings" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="Paths are stored locally in %LocalAppData%\\PPGAV. The scanner never executes files during inspection." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,14" />
                            <TextBlock Text="People Playground directory" Foreground="{StaticResource TextMuted}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseGameDirectory_Click" />
                                <TextBox x:Name="GameDirectoryBox" Margin="0,4,8,10" />
                            </DockPanel>
                            <TextBlock Text="People Playground.exe" Foreground="{StaticResource TextMuted}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseExecutable_Click" />
                                <TextBox x:Name="ExecutableBox" Margin="0,4,8,10" />
                            </DockPanel>
                            <TextBlock Text="Backup directory" Foreground="{StaticResource TextMuted}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseBackupDirectory_Click" />
                                <TextBox x:Name="BackupDirectoryBox" Margin="0,4,8,10" />
                            </DockPanel>
                            <WrapPanel Margin="0,4,0,4">
                                <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" />
                                <CheckBox x:Name="StartMinimizedBox" Content="Start minimized to tray" />
                                <CheckBox x:Name="ScanBeforeLaunchBox" Content="Mandatory preflight scan" IsChecked="True" IsEnabled="False" />
                                <CheckBox x:Name="WatchProcessBox" Content="Watch process behavior" />
                                <CheckBox x:Name="UseWindowsSandboxBox" Content="Prefer Windows Sandbox" />
                                <CheckBox x:Name="RequireNetworkBlockBox" Content="Require safe-mode network block" />
                                <CheckBox x:Name="AutomaticUpdatesBox" Content="Automatically install verified updates" />
                            </WrapPanel>
                            <WrapPanel Margin="0,3,0,0">
                                <TextBlock Text="Backup every" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                                <TextBox x:Name="BackupIntervalBox" Width="44" Margin="0,0,7,0" HorizontalContentAlignment="Center" />
                                <TextBlock Text="hours · keep" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                                <TextBox x:Name="BackupRetentionBox" Width="44" Margin="0,0,7,0" HorizontalContentAlignment="Center" />
                                <TextBlock Text="backups" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                            </WrapPanel>
                            <Button Content="Save settings" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveSettings_Click" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Backups" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="A complete game-directory archive is created every two hours by default. Restore is disabled while the game is running." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Create backup now" Click="BackupNow_Click" />
                                <Button Content="Restore selected" Style="{StaticResource DangerButton}" Click="RestoreBackup_Click" />
                            </WrapPanel>
                            <ListBox x:Name="BackupList" Height="125" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1">
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Quick actions" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="Run a static scan or ask Microsoft Defender to scan the configured game folder." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,13" />
                        <WrapPanel>
                            <Button Content="Inspect now" Style="{StaticResource AccentButton}" Click="ScanNow_Click" />
                            <Button Content="Windows Defender scan" Click="DefenderScan_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="SandboxAvailabilityText" Text="Checking Windows Sandbox…" Foreground="{StaticResource TextMuted}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="18" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Event log" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="Latest detections, launch decisions, backups, and response actions." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <ListBox x:Name="EventList" Height="490">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,1" Background="#0E1622" BorderBrush="#1A2738" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource TextMuted}" DockPanel.Dock="Right" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
